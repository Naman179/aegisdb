# ─────────────────────────────────────────────────────────────────────────────
# aegis.conf.example – Sample AegisDB node configuration file
# ─────────────────────────────────────────────────────────────────────────────

[server]
node_id = 1
client_port = 7001
peer_port = 8001
data_dir = ./data/node1
num_groups = 3
vnodes_per_group = 128
worker_threads = 16
snapshot_threshold = 100000

[cluster]
# Format: id:host:clientPort:peerPort,...
peers = 1:127.0.0.1:7001:8001,2:127.0.0.1:7002:8002,3:127.0.0.1:7003:8003,4:127.0.0.1:7004:8004,5:127.0.0.1:7005:8005

[raft]
heartbeat_ms = 50
min_election_timeout_ms = 150
max_election_timeout_ms = 300
